# LLM Configuration
LLM_PROVIDER=gemini # 'gemini' or 'groq'
LLM_FAILOVER=true

# Gemini Configuration (Primary / Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2= # Optional: secondary key for doubled rate limits
GEMINI_MODEL=gemini-2.0-flash

# Groq Configuration (Fallback / Alternative)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Skyscanner, Kiwi, Duffel & Travel APIs
DUFFEL_API_KEY=your_duffel_token_here
RAPIDAPI_KEY=
SKYSCANNER_API_KEY=
KIWI_API_KEY=
GOOGLE_PLACES_API_KEY=
BOOKING_CONTACT_EMAIL=support@skyscanner.com

# Server & CORS
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:4200,http://localhost:5173,http://localhost:3000

# Token & Cache Settings
ENABLE_TOKEN_TRACKING=true
ENABLE_RESPONSE_CACHE=true
CACHE_TTL_SECONDS=3600
AGENT_TIMEOUT_SECONDS=120
MAX_REVIEW_RETRIES=3
